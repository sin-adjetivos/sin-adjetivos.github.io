---
import Base from '../layouts/Base.astro';
import { temas } from '../lib/datos.js';
import act from '../data/actualidad.json';
import fichas from '../data/fichas.json';
import propias from '../data/noticias_propias.json';
import Esencial from '../components/Esencial.astro';
import TarjetaNoticia from '../components/TarjetaNoticia.astro';
const portada = act.grupos.slice(0, propias.length ? 1 : 3);
const noticias = propias.filter((n) => !n.tipo);
const enPropuestas = propias.filter((n) => n.tipo === 'propuesta');
// La web se genera varias veces al día, así que esta lista no se queda atrasada.
const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
const proximas = [
  ['2026-11-13', '13 de noviembre', 'empieza la campaña electoral.'],
  ['2026-11-19', '19 de noviembre', 'último día para pedir el voto por correo.'],
  ['2026-11-25', '25 de noviembre', 'último día para enviar el voto por correo.'],
  ['2026-11-28', '28 de noviembre', 'jornada de reflexión.'],
  ['2026-11-29', '29 de noviembre', 'votación, de 9:00 a 20:00.'],
].filter(([d]) => d >= hoy).slice(0, 2);
// El resumen de la mañana solo sale en portada el día que se escribe.
const manana = propias.find((n) => n.tipo === 'balance' && n.fecha === hoy);
const WEB = Astro.site.href;
const ld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'NewsMediaOrganization', '@id': `${WEB}#org`, name: 'Sin adjetivos', url: WEB, logo: new URL('icono-256.png', Astro.site).href, founder: { '@type': 'Person', name: 'Sergio Capuchino' }, publishingPrinciples: new URL('metodologia/', Astro.site).href, correctionsPolicy: new URL('correcciones/', Astro.site).href },
  { '@type': 'WebSite', '@id': `${WEB}#web`, name: 'Sin adjetivos', url: WEB, inLanguage: 'es-ES', publisher: { '@id': `${WEB}#org` }, potentialAction: { '@type': 'SearchAction', target: `${WEB}buscar/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
] };
---
<Base descripcion="Noticias de las elecciones del 29 de noviembre y qué propone y qué vota cada partido, con la fuente de cada dato. Sin encuestas y sin pedir el voto.">
  <section class="bienvenida">
    <div class="marco">
      <div>
        <h1>Las elecciones del 29 de noviembre, sin adjetivos</h1>
        <p>Qué pasa y qué propone y vota cada partido, con la fuente de cada dato. Sin partidos detrás, sin encuestas y sin pedir el voto. <a href="/quien-firma/">Quién firma</a>.</p>
      </div>
      {proximas.length > 0 && (
        <p class="proximas"><strong>Próximas fechas.</strong> {proximas.map(([, cuando, que]) => <>{cuando}: {que} </>)}<a href="/como-votar/">Cómo votar y listas de tu provincia</a>.</p>
      )}
    </div>
  </section>

  <div class="marco">
    {manana && (
      <section class="esta-manana">
        <h2><a href={`/actualidad/${manana.id}/`}>{manana.titulo}</a></h2>
        <p>{manana.entradilla} <a href={`/actualidad/${manana.id}/`}>Leer el resumen</a>.</p>
      </section>
    )}

    {noticias.length > 0 && (
      <section class="seccion-primera" aria-label="Noticias de Sin adjetivos">
        <TarjetaNoticia n={noticias[0]} grande />
        {noticias.length > 1 && <div class="tarjetas" style="margin-top:2.5rem">{noticias.slice(1, 7).map((n) => <TarjetaNoticia n={n} />)}</div>}
        <p style="margin-top:1.5rem"><a href="/actualidad/">Ver todas las noticias</a></p>
      </section>
    )}

    {enPropuestas.length > 0 && (
      <section class="seccion">
        <h2>Lo que proponen</h2>
        <div class="tarjetas">{enPropuestas.slice(0, 3).map((n) => <TarjetaNoticia n={n} />)}</div>
      </section>
    )}

    {portada.length > 0 && (
      <section class="seccion">
        <h2>Hoy, según cada medio</h2>
        <div class="noticias">
          {portada.map((g) => (
            <section class="noticia">
              <ul>{g.titulares.slice(0, 4).map((t) => <li><span class="medio">{t.medio}</span><a class="titular" href={t.url} rel="noopener">{t.titulo}</a></li>)}</ul>
              <p class="noticia-dato">Lo publican {g.medios} medios.</p>
            </section>
          ))}
        </div>
        <p style="margin-top:1rem"><a href="/actualidad/#titulares">Ver todos los titulares</a></p>
      </section>
    )}

    {fichas.length > 0 && (
      <section class="seccion">
        <h2>Las votaciones clave, explicadas</h2>
        <Esencial lista={[...fichas].sort((a, b) => b.fecha.localeCompare(a.fecha)).slice(0, 3)} />
      </section>
    )}

    <section class="seccion">
      <h2>Qué propone cada partido, tema por tema</h2>
      <ul class="indice-temas">
        {temas.map((t) => <li><a href={`/temas/${t.id}/`}>{t.nombre}</a></li>)}
      </ul>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>

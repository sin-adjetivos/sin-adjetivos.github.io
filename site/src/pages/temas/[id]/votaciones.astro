---
import Base from '../../../layouts/Base.astro';
import Acta from '../../../components/Acta.astro';
import { temas } from '../../../lib/datos.js';
import { votosTodos } from '../../../lib/archivo.js';

export function getStaticPaths() {
  return temas.map((t) => ({ params: { id: t.id }, props: { tema: t } }));
}
const { tema } = Astro.props;
const vs = votosTodos().filter((v) => v.temas.includes(tema.id)).sort((a, b) => b.fecha.localeCompare(a.fecha));
---
<Base titulo={`Votaciones sobre ${tema.nombre} en el Congreso`} descripcion={`Qué votó cada grupo en el Congreso sobre ${tema.nombre} en esta legislatura, con los datos oficiales de cada votación.`}>
  <div class="marco">
    <header class="entrada">
      <h1 class="h1-largo">{tema.nombre}: todas las votaciones</h1>
      <p>{vs.length} votaciones del Pleno cuyo título contiene palabras de este tema, de la más reciente a la más antigua. <a href={`/temas/${tema.id}/`}>Volver al tema</a>.</p>
    </header>
    {vs.map((v) => <Acta v={v} />)}
  </div>
</Base>

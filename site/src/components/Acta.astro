---
import Chip from './Chip.astro';
import { fecha, reparto } from '../lib/datos.js';
import { sentido } from '../lib/archivo.js';
const { v } = Astro.props;
const r = reparto(v);
const nota = v.sentido ?? sentido(v.titulo);
const ficha = v.ficha ?? (v.expediente ? `https://www.congreso.es/busqueda-de-iniciativas?p_p_id=iniciativas&p_p_lifecycle=0&p_p_state=normal&p_p_mode=view&_iniciativas_mode=mostrarDetalle&_iniciativas_legislatura=XV&_iniciativas_id=${v.expediente}` : null);
---
<article class="acta" id={v.id}>
  <h3>{v.corto ?? v.titulo}</h3>
  <p class="acta-dato">{fecha(v.fecha)}{v.corto !== v.resultado && <>. {v.resultado}</>}: <b>{v.si} sí, {v.no} no, {v.abst} abstenciones.</b></p>
  {nota && <p class="acta-sentido">{nota}</p>}
  {r ? (
    <dl class="reparto">
      {Object.entries(r).filter(([, l]) => l.length).map(([o, l]) => (
        <>
          <dt>{o}</dt>
          <dd>{l.map((x) => <Chip id={x.id} n={x.n}>{x.nombre}</Chip>)}</dd>
        </>
      ))}
    </dl>
  ) : (
    <p class="nota" style="margin-top:.5rem">No mostramos el voto por grupo: los datos abiertos del Congreso solo dan el total y la lista nominal del Diario no cuadra con él.</p>
  )}
  {v.origen_grupos === 'diario' && <p class="nota" style="margin-top:.5rem">Votación por llamamiento. El voto por grupo lo hemos contado a partir de la lista nominal del Diario de Sesiones, y la suma coincide con el total oficial.</p>}
  <p class="acta-enlaces">
    {ficha && <a href={ficha} rel="noopener">Ficha del Congreso</a>}
    {v.json && <a href={v.json} rel="noopener">Voto de cada diputado</a>}
    {v.diario && <a href={v.diario} rel="noopener">Diario de Sesiones</a>}
    {(v.debates || []).slice(0, 1).map((d) => <a href={`/debates/${d}/`}>Leer el debate</a>)}
  </p>
</article>

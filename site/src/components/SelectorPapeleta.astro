---
import { provincias } from '../lib/datos.js';
import { COLORES } from '../lib/color.js';
import AVISOS from '../data/avisos_papeleta.json';
---
<section class="portada banda-papeleta" id="tu-papeleta">
  <div class="marco">
    <h2>Mira tu papeleta</h2>
    <div class="portada-fila">
    <p class="portada-intro">Elige tu provincia y verás las listas al Congreso que encontrarás el 29 de noviembre, tal como las publicó el BOE, y lo que cada candidatura propone, vota y dice.</p>
    <div class="selector">
      <label for="prov">Tu provincia</label>
      <select id="prov">
        <option value="">Elige una</option>
        {provincias.map((p) => <option value={p.slug}>{p.nombre}</option>)}
      </select>
    </div>
    </div>
    <p class="aviso" id="aviso-prov" hidden></p>
    <noscript><p style="margin-top:1rem"><a href="/papeleta/">Ver todas las provincias</a></p></noscript>
  </div>
  <div class="mazo" id="mazo" aria-live="polite">
    {[0, 1, 2, 3].map(() => (
      <article class="papeleta vacia" aria-hidden="true">
        <p class="papeleta-cab">Elecciones al Congreso de los Diputados<br />29 de noviembre de 2026</p>
        <h3>Sin provincia elegida</h3>
        {[0, 1, 2, 3, 4, 5].map(() => <div class="renglon"></div>)}
      </article>
    ))}
  </div>
</section>

<script is:inline define:vars={{ COLORES, AVISOS }}>
  (function () {
    var sel = document.getElementById('prov'), mazo = document.getElementById('mazo'), avisoProv = document.getElementById('aviso-prov');
    function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    function papeleta(c, prov, i) {
      var nombres = c.lista.map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('');
      var sup = c.suplentes.length ? '<p class="papeleta-sup">Suplentes: ' + c.suplentes.map(esc).join(', ') + '</p>' : '';
      var pie = c.expediente
        ? '<a href="/candidaturas/' + c.expediente + '/">Ver qué propone y qué votó</a>'
        : '<span>Sin grupo en el Congreso saliente: no hay expediente.</span>';
      var banda = c.expediente && COLORES[c.expediente] ? ';border-top:.6rem solid ' + COLORES[c.expediente] : '';
      return '<article class="papeleta" style="--i:' + Math.min(i, 12) + banda + '">' +
        '<p class="papeleta-cab">Elecciones al Congreso de los Diputados<br>29 de noviembre de 2026<br>Circunscripción de ' + esc(prov) + '</p>' +
        '<h3>' + esc(c.nombre) + '</h3><ol tabindex="0" aria-label="Candidatos">' + nombres + '</ol>' + sup +
        '<p class="papeleta-pie">' + pie + '</p></article>';
    }
    function cargar(slug) {
      var a = AVISOS[slug];
      avisoProv.hidden = !a;
      avisoProv.textContent = a ? a.texto : '';
      if (!slug) return;
      fetch('/datos/papeleta/' + slug + '.json').then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json();
      }).then(function (d) {
        var lista = window.barajarCandidaturas(d.candidaturas.slice());
        mazo.classList.remove('repartido');
        mazo.innerHTML = lista.map(function (c, i) { return papeleta(c, d.nombre, i); }).join('');
        void mazo.offsetWidth;
        mazo.classList.add('repartido');
        mazo.scrollLeft = 0;
      }).catch(function () {
        mazo.innerHTML = '<p>No se han podido cargar las listas. Prueba en <a href="/papeleta/' + slug + '/">la página de esta provincia</a>.</p>';
      });
    }
    sel.addEventListener('change', function () {
      try { localStorage.setItem('provincia', sel.value); } catch (e) {}
      cargar(sel.value);
    });
    var guardada; try { guardada = localStorage.getItem('provincia'); } catch (e) {}
    if (guardada && sel.querySelector('option[value="' + guardada + '"]')) { sel.value = guardada; cargar(guardada); }
  })();
</script>

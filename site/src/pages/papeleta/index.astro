---
import Base from '../../layouts/Base.astro';
import { provincias, resumen } from '../../lib/datos.js';
---
<Base titulo="Listas al Congreso por provincia, 29 de noviembre" descripcion="Elige tu provincia y mira las candidaturas proclamadas al Congreso para el 29 de noviembre de 2026, con todos sus nombres, según el BOE.">
  <div class="marco">
    <header class="entrada">
      <h1>Listas por provincia</h1>
      <p>Las {resumen.candidaturas_congreso} candidaturas proclamadas al Congreso en las {resumen.provincias} circunscripciones, según el <a href="https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-23103" rel="noopener">BOE del 3 de noviembre de 2026</a>. Las listas al Senado se consultan en el propio BOE.</p>
    </header>
    <ul style="columns:3 12rem;column-gap:2rem">
      {provincias.map((p) => <li><a href={`/papeleta/${p.slug}/`}>{p.nombre}</a></li>)}
    </ul>
  </div>
</Base>
